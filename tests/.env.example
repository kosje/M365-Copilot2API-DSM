# Template for the credentials required by tests/*.py.
#
# Copy to tests/.env and fill in real values, then export them in your shell.
# tests/.env is git-ignored (.env is a global pattern in the root
# .gitignore); .env.example itself is deliberately tracked, so never put a
# real secret in THIS file.
#
#   bash:        set -a; source tests/.env; set +a
#   PowerShell:  Get-Content tests/.env | ForEach-Object {
#                  if ($_ -match '^\s*([^#=]+)=(.*)$') {
#                    Set-Item "env:$($matches[1].Trim())" $matches[2].Trim() } }

# Gateway administrator password.
M365_TEST_ADMIN_PW=replace-with-a-real-password

# An API key created under "API Keys" in the console. Prefer a dedicated key
# with a short expiry so a leaked test key has a bounded blast radius.
M365_TEST_API_KEY=m365_replace-with-a-real-key

# Optional: base URL of the gateway under test.
# M365_TEST_BASE=http://127.0.0.1:4141

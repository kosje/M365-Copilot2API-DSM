#!/bin/sh
# Retain account data across an uninstall unless the admin explicitly asked for
# the data to be deleted.
#
# The retained copy lives OUTSIDE /var/packages/<pkg>/ because uninstalling a
# DSM package removes that whole directory, which would take a copy stored
# inside it along with everything else. The fnOS port of this project keeps its
# retained data under <volume>/@appdata for the same reason.
#
# Caveat worth knowing: DSM only surfaces a "delete data" choice when the
# package ships an uninstall wizard, and this package does not - there is no way
# to ask for the administrator password on uninstall. The status variables are
# checked below for the spellings DSM has used, but if the operator asks for
# deletion and none of them is set, the retained copy survives. The path is
# logged so it can be removed by hand; see spk/MAINTAINING.md.

set -eu

PKG="${SYNOPKG_PKGNAME:-m365-copilot2api}"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"
DATA_DIR="$VAR_DIR/data"
LOGFILE="${SYNOPKG_TEMP_LOGFILE:-/tmp/$PKG-preuninst.log}"

log() { echo "$*" >> "$LOGFILE" 2>/dev/null || true; }

# Must match preupgrade's retain_base().
retain_base() {
    for vol in ${SYNOPKG_PKGDEST_VOL:-} /volume1 /volume2 /volume3 /volume4 /volume5; do
        [ -n "$vol" ] || continue
        [ -d "$vol/@appdata" ] || continue
        printf '%s/@appdata/%s\n' "$vol" "$PKG"
        return 0
    done
    printf '%s\n' "$VAR_DIR/.."
}

RETAIN="$(retain_base)"
KEEP_DIR="$RETAIN/keep"
# Where revisions before this one kept the retained copy.
LEGACY_KEEP_DIR="/var/packages/$PKG/keep"

# An upgrade also fires the uninstall hooks on some DSM builds; never discard
# data there.
if [ "${SYNOPKG_PKG_STATUS:-}" = "UPGRADE" ]; then
    exit 0
fi

# Explicit deletion. Cover both the wizard variable and the status value DSM
# uses when the operator ticks "delete data".
if [ "${pkgwizard_delete_data:-}" = "true" ] || [ "${SYNOPKG_PKG_STATUS:-}" = "UNINSTALL_DELDATA" ]; then
    rm -rf "$KEEP_DIR" "$LEGACY_KEEP_DIR" 2>/dev/null || true
    log "preuninst: data deletion requested; removed $KEEP_DIR"
    exit 0
fi

if [ ! -f "$DATA_DIR/accounts.json" ]; then
    log "preuninst: no accounts.json at $DATA_DIR; nothing to retain"
    exit 0
fi

if ! mkdir -p "$KEEP_DIR"; then
    log "preuninst: cannot create $KEEP_DIR; data will not be retained"
    exit 1
fi

if ! cp -a "$DATA_DIR/." "$KEEP_DIR/"; then
    log "preuninst: retaining $DATA_DIR at $KEEP_DIR failed"
    exit 1
fi

if [ ! -s "$KEEP_DIR/accounts.json" ]; then
    log "preuninst: retained copy at $KEEP_DIR is missing accounts.json"
    exit 1
fi

chmod 700 "$KEEP_DIR" 2>/dev/null || true
# A stale copy in the old in-package location would be restored by postinst
# ahead of this one, so drop it now that the new location holds a newer copy.
rm -rf "$LEGACY_KEEP_DIR" 2>/dev/null || true

log "preuninst: retained $DATA_DIR at $KEEP_DIR (delete it by hand to erase the accounts and tokens)"
exit 0

#!/bin/sh
# M365 Copilot2API — Synology DSM 7 service control
#
# Ported from the fnOS FPK cmd/main. DSM lifecycle variables replace the
# fnOS ones:
#   $TRIM_APPDEST       -> $SYNOPKG_PKGDEST   (/var/packages/<pkg>/target)
#   $TRIM_PKGVAR        -> $SYNOPKG_PKGVAR    (/var/packages/<pkg>/var)
#   $TRIM_TEMP_LOGFILE  -> $SYNOPKG_TEMP_LOGFILE

set -u

APP_DIR="${SYNOPKG_PKGDEST:-/var/packages/m365-copilot2api/target}"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/m365-copilot2api/var}"
DATA_DIR="$VAR_DIR/data"
LOGFILE="${SYNOPKG_TEMP_LOGFILE:-/tmp/m365-copilot2api.log}"

CONFIG="$DATA_DIR/accounts.json"
APIKEYS="$DATA_DIR/api-keys.json"
PWFILE="$DATA_DIR/admin-password"
WIZARD_PW="$VAR_DIR/admin-password-wizard"
APPLOG="$DATA_DIR/app.log"
PIDFILE="$VAR_DIR/m365-copilot2api.pid"

# Port is fixed at 4141 (INFO adminport, firewall .sc and the wizard text all
# agree); nothing to read from the wizard.
PORT="4141"
LISTEN="0.0.0.0:$PORT"

BIN=""
for cand in "$APP_DIR/bin/m365-copilot2api" "$APP_DIR/m365-copilot2api"; do
    if [ -x "$cand" ]; then
        BIN="$cand"
        break
    fi
done

running() {
    [ -n "$BIN" ] || return 1
    [ -f "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$pid" ] || return 1
    # Confirm the pid is still our binary and not a recycled number.
    [ -d "/proc/$pid" ] || return 1
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)"
    # Guard the empty case explicitly: with an unset BIN the patterns below
    # would collapse to "" and match a failed readlink, reporting a dead
    # service as running.
    [ -n "$exe" ] && case "$exe" in
        "$BIN"|"$BIN "*) return 0 ;;
    esac
    # readlink may be unavailable to a non-root user; fall back to cmdline.
    if grep -qs "m365-copilot2api" "/proc/$pid/cmdline"; then
        return 0
    fi
    return 1
}

case "$1" in
    start)
        if [ -z "$BIN" ]; then
            echo "binary not found under $APP_DIR" > "$LOGFILE"
            exit 1
        fi
        if running; then
            exit 0
        fi

        mkdir -p "$DATA_DIR"
        chmod 700 "$DATA_DIR" 2>/dev/null

        M365_LISTEN="$LISTEN"
        M365_DATA_DIR="$DATA_DIR"
        M365_CONFIG="$CONFIG"
        M365_API_KEYS="$APIKEYS"
        M365_ADMIN_PASSWORD_FILE="$PWFILE"
        export M365_LISTEN M365_DATA_DIR M365_CONFIG M365_API_KEYS M365_ADMIN_PASSWORD_FILE

        # Hand the wizard password over as M365_ADMIN_PASSWORD, which is the
        # only input the reset path keys off: the app fingerprints this value
        # into <data dir>/admin-envhash and re-applies it only when it differs
        # from the last one applied. So a reinstall with a NEW wizard password
        # resets a forgotten password, while a routine restart leaves a
        # console-changed password alone.
        #
        # M365_ADMIN_PASSWORD_BOOTSTRAP_FILE is deliberately not used: it is
        # consulted only when no password is stored at all, so with the data
        # directory retained across an uninstall it would never fire and the
        # wizard's "reinstall to reset" promise would silently do nothing.
        if [ -s "$WIZARD_PW" ]; then
            M365_ADMIN_PASSWORD="$(cat "$WIZARD_PW")"
            export M365_ADMIN_PASSWORD
        fi

        cd "$(dirname "$BIN")" || exit 1
        nohup "$BIN" >> "$APPLOG" 2>&1 &
        echo $! > "$PIDFILE"

        # Wait for the listener so Package Center's post-install status check
        # does not race the bind.
        i=0
        while [ "$i" -lt 30 ]; do
            if running; then
                sleep 1
                exit 0
            fi
            i=$((i + 1))
            sleep 1
        done
        echo "failed to start $BIN; see $APPLOG" > "$LOGFILE"
        exit 1
        ;;

    stop)
        if running; then
            pid="$(cat "$PIDFILE" 2>/dev/null)"
            kill "$pid" 2>/dev/null
            i=0
            while [ "$i" -lt 20 ]; do
                running || break
                i=$((i + 1))
                sleep 1
            done
            running && kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PIDFILE"
        exit 0
        ;;

    status)
        if running; then
            exit 0
        fi
        exit 1
        ;;

    log)
        echo "$APPLOG"
        exit 0
        ;;

    *)
        echo "usage: $0 {start|stop|status|log}" > "$LOGFILE"
        exit 1
        ;;
esac

#!/bin/sh
# M365 Copilot2API — Synology DSM 7 service control
#
# Ported from the fnOS FPK cmd/main. DSM lifecycle variables replace the
# fnOS ones:
#   $TRIM_APPDEST       -> $SYNOPKG_PKGDEST   (/var/packages/<pkg>/target)
#   $TRIM_PKGVAR        -> $SYNOPKG_PKGVAR    (/var/packages/<pkg>/var)
#   $TRIM_TEMP_LOGFILE  -> $SYNOPKG_TEMP_LOGFILE

set -eu

APP_DIR="${SYNOPKG_PKGDEST:-/var/packages/m365-copilot2api/target}"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/m365-copilot2api/var}"
DATA_DIR="$VAR_DIR/data"
LOGFILE="${SYNOPKG_TEMP_LOGFILE:-/tmp/m365-copilot2api.log}"

CONFIG="$DATA_DIR/accounts.json"
APIKEYS="$DATA_DIR/api-keys.json"
PWFILE="$DATA_DIR/admin-password"
# Staged by postinst from the install wizard value. The service reads it,
# deletes it, and fingerprints the value into <data dir>/admin-envhash so a
# routine restart does not keep re-applying it.
RESET_PW="$VAR_DIR/admin-password-reset"
APPLOG="$DATA_DIR/app.log"
PIDFILE="$VAR_DIR/m365-copilot2api.pid"
LOG_MAX_BYTES=5242880

# Port is fixed at 4141 (INFO adminport, firewall .sc and the wizard text all
# agree); nothing to read from the wizard.
PORT="4141"

# Listening on all interfaces is required: serving LAN clients an
# OpenAI-compatible endpoint is the point of this package, so loopback-only
# would break it. The trade-off is that the admin console then also speaks plain
# HTTP over the network, putting the login password and the session cookie on
# the wire. If M365_LISTEN is already set in the environment it wins, so an
# operator can restrict the interface or put a TLS-terminating reverse proxy in
# front; see SECURITY.md. The service logs a warning at startup whenever the
# console is reachable over plain HTTP from a non-loopback address.
LISTEN="${M365_LISTEN:-0.0.0.0:$PORT}"

BIN=""
for cand in "$APP_DIR/bin/m365-copilot2api" "$APP_DIR/m365-copilot2api"; do
    if [ -x "$cand" ]; then
        BIN="$cand"
        break
    fi
done

running() {
    [ -n "$BIN" ] || return 1
    [ -f "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$pid" ] || return 1
    # Confirm the pid is still our binary and not a recycled number.
    [ -d "/proc/$pid" ] || return 1
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)"
    # Guard the empty case explicitly: with an unset BIN the patterns below
    # would collapse to "" and match a failed readlink, reporting a dead
    # service as running.
    [ -n "$exe" ] && case "$exe" in
        "$BIN"|"$BIN "*) return 0 ;;
    esac
    # readlink may be unavailable to a non-root user; fall back to cmdline.
    if grep -qs "m365-copilot2api" "/proc/$pid/cmdline"; then
        return 0
    fi
    return 1
}

case "$1" in
    start)
        if [ -z "$BIN" ]; then
            echo "binary not found under $APP_DIR" > "$LOGFILE"
            exit 1
        fi
        if running; then
            exit 0
        fi

        mkdir -p "$DATA_DIR" || { echo "cannot create $DATA_DIR" > "$LOGFILE"; exit 1; }
        chmod 700 "$DATA_DIR" 2>/dev/null || true

        M365_LISTEN="$LISTEN"
        M365_DATA_DIR="$DATA_DIR"
        M365_CONFIG="$CONFIG"
        M365_API_KEYS="$APIKEYS"
        M365_ADMIN_PASSWORD_FILE="$PWFILE"
        export M365_LISTEN M365_DATA_DIR M365_CONFIG M365_API_KEYS M365_ADMIN_PASSWORD_FILE

        # Point the service at the wizard password file instead of exporting the
        # password itself. An earlier revision exported M365_ADMIN_PASSWORD,
        # which put the cleartext in this process's environment for as long as
        # the service ran - readable by any process running as the same user via
        # /proc/<pid>/environ. The service reads this file on start, deletes it,
        # and fingerprints the value into <data dir>/admin-envhash, so a
        # reinstall with a NEW wizard password still resets a forgotten one
        # while a routine restart leaves a console-changed password alone.
        #
        # M365_ADMIN_PASSWORD_BOOTSTRAP_FILE is still deliberately not used: it
        # is consulted only when no password is stored at all, so with the data
        # directory retained across an uninstall it would never fire and the
        # wizard's "reinstall to reset" promise would silently do nothing.
        if [ -s "$RESET_PW" ]; then
            M365_ADMIN_PASSWORD_RESET_FILE="$RESET_PW"
            export M365_ADMIN_PASSWORD_RESET_FILE
        fi

        # Keep the log bounded: it is appended to on every start and there is no
        # other rotation, so an unattended NAS would grow it indefinitely.
        LOG_SIZE="$(wc -c < "$APPLOG" 2>/dev/null || echo 0)"
        if [ "${LOG_SIZE:-0}" -gt "$LOG_MAX_BYTES" ]; then
            mv -f "$APPLOG" "$APPLOG.1" 2>/dev/null || true
        fi
        LOG_OFFSET="$(wc -c < "$APPLOG" 2>/dev/null || echo 0)"

        cd "$(dirname "$BIN")" || exit 1
        nohup "$BIN" >> "$APPLOG" 2>&1 &
        echo $! > "$PIDFILE"

        # Wait for the listener. Checking the process alone is not enough:
        # nohup returns immediately, so a bind failure (port already in use)
        # would still be reported as a successful start. Look for the line the
        # server logs once it is listening, counting only output produced by
        # this start.
        i=0
        started=0
        while [ "$i" -lt 30 ]; do
            if ! running; then
                break
            fi
            if [ -n "${LOG_OFFSET:-}" ] && \
               tail -c "+$((LOG_OFFSET + 1))" "$APPLOG" 2>/dev/null | grep -q "listening on"; then
                started=1
                break
            fi
            i=$((i + 1))
            sleep 1
        done
        if [ "$started" = 1 ]; then
            exit 0
        fi
        echo "failed to start $BIN (no listener after ${i}s); see $APPLOG" > "$LOGFILE"
        exit 1
        ;;

    stop)
        if running; then
            pid="$(cat "$PIDFILE" 2>/dev/null || true)"
            # Guard every kill: under `set -e` an unguarded failure here would
            # skip the PID file cleanup and report a non-zero status for what is
            # really an already-stopped service.
            kill "$pid" 2>/dev/null || true
            i=0
            while [ "$i" -lt 20 ]; do
                running || break
                i=$((i + 1))
                sleep 1
            done
            if running; then
                kill -9 "$pid" 2>/dev/null || true
                sleep 1
            fi
        fi
        rm -f "$PIDFILE"
        exit 0
        ;;

    status)
        if running; then
            exit 0
        fi
        exit 1
        ;;

    log)
        echo "$APPLOG"
        exit 0
        ;;

    *)
        echo "usage: $0 {start|stop|status|log}" > "$LOGFILE"
        exit 1
        ;;
esac

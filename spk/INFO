package="m365-copilot2api"
version="1.6.33-0010"
os_min_ver="7.0-40000"
# x86_64, not noarch: the package ships a single linux/amd64 binary. Claiming
# noarch let Package Center install it on ARM models (DS223 and friends), where
# the binary then failed to exec and the package sat permanently stopped.
arch="x86_64"
displayname="Copilot2API"
description="M365 Copilot2API 本地网关（群晖 DSM 版）。把 Microsoft 365 Copilot 转换为 OpenAI / Anthropic 兼容 API，供任意 OpenAI 客户端（Claude Code、OpenWebUI、ChatBox、Cherry Studio 等）调用。自带 Web 管理控制台：账号授权（设备码登录为主，手动粘贴回调地址作备用）、API Key 管理与额度（含 auto 智能路由模型池）、代理池、用量统计、/chat 轻量对话端。服务端口 4141，安装向导可设置管理员密码。升级请在套件中心安装新版 SPK。"
maintainer="kosje"
maintainer_url="https://github.com/kosje/M365-Copilot2API-DSM"
support_url="https://github.com/kosje/M365-Copilot2API-DSM/issues"
thirdparty="yes"
startable="yes"
silent_install="no"
silent_upgrade="no"
silent_uninstall="no"
install_reboot="no"
adminport="4141"
adminprotocol="http"
adminurl="/"
dsmuidir="ui"
dsmappname="com.kosje.m365copilot2api"
